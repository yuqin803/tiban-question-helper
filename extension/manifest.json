{
  "manifest_version": 3,
  "name": "题伴 · 浏览器答题助手",
  "version": "1.6.32",
  "description": "侧栏识题与可选自动填写，支持选择题、普通填空、截图、网站适配和经核验的本地选择题题库。",
  "minimum_chrome_version": "116",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开题伴"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none';"
  }
}
